# Copiar a .env y completar. Nunca subir el .env al repositorio.

# --- IA (opcional): solo para los PDF que las reglas no entienden (escaneados, formatos raros) ---
# Sin clave, esos PDF quedan en la hoja "Revisar" y no se llama a ninguna API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5
ANTHROPIC_URL=https://api.anthropic.com
IA_HABILITADA=true
IA_TIMEOUT=60
IA_MAX_TOKENS=1500
IA_REINTENTOS=3

# --- Carpetas y registro ---
# Registro de archivos ya procesados (por hash), para no cargar dos veces la misma factura
REGISTRO_PATH=datos/registro.json
# Por defecto se crean dentro de la carpeta de entrada: <entrada>/procesadas y <entrada>/errores
CARPETA_PROCESADAS=
CARPETA_ERRORES=
# Segundos entre revisiones con --vigilar
INTERVALO_VIGILAR=10

# --- Validaciones ---
# Diferencia máxima aceptada entre (neto + impuestos + percepciones) y el total, en pesos
TOLERANCIA_SUMA=0.05

# --- Envío a ERP / API por webhook (opcional) ---
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_REINTENTOS=3
WEBHOOK_TIMEOUT=15
# true = también manda las facturas con estado "revisar"
WEBHOOK_ENVIAR_REVISAR=false

# --- Salidas y logs ---
CSV_SEPARADOR=;
LOG_NIVEL=INFO
